  "item": [
    {
      "name": "POST - Create valid assignment (expect 201)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 201', () => pm.response.to.have.status(201));",
              "pm.test('Status is Scheduled', () => {",
              "    const body = pm.response.json();",
              "    pm.expect(body.status).to.eql('Scheduled');",
              "    pm.collectionVariables.set('assignmentId', body.assignmentId);",
              "});",
              "pm.test('Location header present', () => pm.response.headers.has('Location'));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"employeeId\": 1,\n  \"departmentId\": 7,\n  \"assignmentDate\": \"2026-08-25T00:00:00Z\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/assignment",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "assignment"
          ]
        }
      },
      "response": []
